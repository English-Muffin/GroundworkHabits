{
  "name": "groundwork-habits",
  "version": "1.7.1",
  "description": "Habits, tasks and goals in one calm place.",
  "main": "electron/main.js",
  "author": "English-Muffin",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never && node tools/build_portable.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "dist:mac": "electron-builder --mac zip --universal --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.daybook.app",
    "productName": "Groundwork Habits",
    "files": [
      "electron/**",
      "www/**",
      "assets/icon.png",
      "!node_modules/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "Groundwork-Habits-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "compression": "normal",
    "electronLanguages": [
      "en-US"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Groundwork-Habits-${version}-Windows-setup.exe",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Groundwork Habits"
    }
  },
  "dependencies": {
    "@capacitor/local-notifications": "^6.1.3",
    "daybook-native": "file:native/daybook-native"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/English-Muffin/GroundworkHabits.git"
  },
  "homepage": "https://github.com/English-Muffin/GroundworkHabits"
}
