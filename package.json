{
  "name": "daybook",
  "version": "1.4.0",
  "description": "Habits, tasks and goals in one calm place.",
  "main": "electron/main.js",
  "author": "English-Muffin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --publish never",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "dist:mac": "electron-builder --mac zip --universal --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.daybook.app",
    "productName": "Daybook",
    "files": [
      "electron/**",
      "www/**",
      "assets/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-Windows-portable.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@capacitor/local-notifications": "^6.1.3",
    "daybook-native": "file:native/daybook-native"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/English-Muffin/Free-Habit-Tracker.git"
  },
  "homepage": "https://github.com/English-Muffin/Free-Habit-Tracker"
}
